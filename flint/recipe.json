{
  "id": "flint",
  "title": "Flint 40B-A2.5B at 128k on llama.cpp",
  "summary": "A 23.4 GB MoE GGUF on a 12 GB card at 128k context: every routed expert in RAM, the freed VRAM spent on llama.cpp's adaptive MoE cache. 58.8 tok/s decode, 1,708 tok/s prefill.",
  "status": "measured",
  "updated": "2026-11-22",
  "use_cases": [
    "coding",
    "agents",
    "long-context",
    "opencode"
  ],
  "model": {
    "name": "Flint",
    "hf_repo": "RecursiveSI/flint",
    "params": "40B, 2.5B active",
    "architecture": "MoE, 49 layers, 256 experts top-6 plus shared experts"
  },
  "weights": {
    "format": "GGUF",
    "quant": "Q4_K_M",
    "size_gb": 23.4,
    "source": "https://huggingface.co/ggml-org/Flint-GGUF",
    "file": "Flint-Q4_K_M.gguf"
  },
  "engine": {
    "name": "llama.cpp",
    "repo": "https://github.com/ggml-org/llama.cpp",
    "version": "b12242 (3b4d6ab3f), release build",
    "cuda": "12.8"
  },
  "hardware": {
    "gpu": "NVIDIA GeForce RTX 3060",
    "vram_gb": 12,
    "ram_gb": 62,
    "cpu": "Intel Core i5-12500",
    "disk": "NVMe SSD",
    "os": "Linux",
    "driver": "610.57.04",
    "notes": "PCIe Gen4 x16. RAM read bandwidth measured at 57 GB/s."
  },
  "serve": {
    "command": "./serve.sh",
    "script": "serve.sh",
    "port": 8081,
    "api": "OpenAI-compatible",
    "key_flags": [
      "-ngl 99 -ncmoe 49",
      "--moe-cache-mib 2944 --moe-cache-cpu-share 0.95",
      "-c 131072 -np 1 -t 6",
      "-b 4096 -ub 4096",
      "--load-mode none",
      "-fa on -ctk f16 -ctv f16",
      "--spec-type ngram-map-k",
      "--fit off"
    ]
  },
  "context_tokens": 131072,
  "placement": "All routed experts in RAM (about 20 GB, read into RAM, not mmap'd). VRAM holds the dense layers, the f16 KV cache and a 2944 MiB cache of the hottest experts.",
