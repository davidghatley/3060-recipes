{
  "id": "inkling-2-mini",
  "title": "Inkling-2-Mini 26.4B looped MoE at 64k on llama.cpp",
  "summary": "A 17.6 GB looped MoE on a 12 GB card: the experts of the loop core (layers 6-17, read three times per token) on the GPU, the rest in RAM. 29.0 tok/s decode against 17.5 stock, 145 tok/s prefill at 8k.",
  "status": "measured",
  "updated": "2026-11-22",
  "use_cases": [
    "coding",
    "reasoning",
    "vision",
    "long-context"
  ],
  "model": {
    "name": "Inkling-2-Mini",
    "hf_repo": "thinkingmachines/Inkling-2-Mini",
    "params": "26.4B",
    "architecture": "looped MoE, 24 layers, 128 experts (8 active); layers 6-17 run 3 times per token; image input"
  },
  "weights": {
    "format": "GGUF",
    "quant": "IQ4_NL",
    "size_gb": 17.6,
    "source": "https://huggingface.co/ggml-org/Inkling-2-Mini-GGUF",
    "file": "Inkling-2-Mini-IQ4_NL.gguf",
    "revision": "db61c5b4",
    "notes": "Options: Unsloth's Mainline_Support 2-bit and 3-bit files (unsloth/Inkling-2-Mini-GGUF @ 45fd0876) and our NVFP4 repack."
  },
  "engine": {
    "name": "llama.cpp",
    "repo": "https://github.com/ggml-org/llama.cpp",
    "version": "master 225a5345b (build 12627)",
    "patches": [
      "inkling-2-mini/patches/0001 and 0002: F16 relative-bias mask, needed only for 64k with IQ4_NL"
    ],
    "cuda": "12.9"
  },
  "hardware": {
    "gpu": "NVIDIA GeForce RTX 3060",
    "vram_gb": 12,
    "ram_gb": 62,
    "cpu": "Intel Core i5-12500",
    "disk": "NVMe SSD",
    "os": "Linux",
    "driver": "615.78.08",
    "notes": "sm_86. The desktop holds 0.95 GB of the card. RAM read bandwidth 57.1 GB/s at 6 threads."
  },
  "serve": {
    "command": "INK_NO_GPU_RUN=1 ./serve.sh",
    "script": "serve.sh",
    "port": 8085,
    "api": "OpenAI-compatible",
    "key_flags": [
      "-ngl 99 --fit off",
      "-ot 'blk\\.([0-5]|1[89]|2[0-3])\\.ffn_.*_exps=CPU'",
      "-c 65536 -np 1 -t 6",
      "-b 2048 -ub 128",
      "-fa on -ctk q8_0 -ctv q8_0",
      "--jinja --reasoning-format deepseek"
    ]
  },
  "context_tokens": 65536,
  "placement": "VRAM: all dense weights and the experts of loop-core layers 6-17 (6.4 GiB). RAM: the experts of layers 0-5 and 18-23, mmap'd.",
