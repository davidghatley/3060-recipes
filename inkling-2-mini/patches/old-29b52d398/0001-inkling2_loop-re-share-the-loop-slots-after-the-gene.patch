From 7c396f834806e440f73281383a019d8c1d06b184 Mon Sep 17 00:00:00 2001
From: 3060-recipes <noreply@localhost>
Date: Fri, 20 Nov 2026 16:19:11 -0700
Subject: [PATCH 1/3] inkling2_loop: re-share the loop slots after the generic
 .scale pass

---
 src/llama-model.cpp          | 5 +++++
 src/models/inkling2-loop.cpp | 4 ++++
 src/models/models.h          | 2 ++
 3 files changed, 11 insertions(+)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 4c77f6f68..4e862a407 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -2006,6 +2006,11 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
                 layer.nextn.shared_head_head_in_s = create_tensor(tn(LLM_TENSOR_NEXTN_SHARED_HEAD_HEAD, "input_scale", i), {1}, TENSOR_NOT_REQUIRED);
             }
         }
+        // looped models alias the cache slots past the stored layers to their physical layer before this pass,
+        // so the slots got no scales: share them again so that the later loop passes keep them
+        if (arch == LLM_ARCH_INKLING2_LOOP) {
+            static_cast<llama_model_inkling2_loop *>(this)->share_loop_layers();
+        }
         // output scales
         if (output) {
             // weight scale
diff --git a/src/models/inkling2-loop.cpp b/src/models/inkling2-loop.cpp
index 0de66baee..38d3dffd3 100644
--- a/src/models/inkling2-loop.cpp
+++ b/src/models/inkling2-loop.cpp
@@ -62,6 +62,10 @@ void llama_model_inkling2_loop::load_arch_tensors(llama_model_loader & ml) {
     }
 
     // share the physical weights, each cache slot keeps its own KV and conv state
+    share_loop_layers();
+}
+
+void llama_model_inkling2_loop::share_loop_layers() {
     for (int il = n_phys; il < (int) hparams.n_layer(); ++il) {
         layers[il] = layers[layer_phys(il)];
     }
diff --git a/src/models/models.h b/src/models/models.h
index 636afeae9..9f53ddf78 100644
--- a/src/models/models.h
+++ b/src/models/models.h
@@ -2550,6 +2550,8 @@ struct llama_model_inkling2_loop : public llama_model_inkling2 {
 
     int n_layer_phys() const override { return n_phys; }
     int layer_phys(int il) const;
+    // copy the physical layers into the slots of the later loop passes
+    void share_loop_layers();
 
     int      n_phys     = 0;
     uint32_t core_start = 0;
-- 
2.56.0

