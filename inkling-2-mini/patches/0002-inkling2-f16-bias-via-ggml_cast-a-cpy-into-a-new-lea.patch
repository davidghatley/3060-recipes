From 19c41d2ff14fcea23f1ec1b6bb8324ed48317414 Mon Sep 17 00:00:00 2001
From: local <local@localhost>
Date: Fri, 20 Nov 2026 17:30:53 -0700
Subject: [PATCH 2/3] inkling2: f16 bias via ggml_cast (a cpy into a new leaf
 tensor pinned every layer's mask)

---
 src/models/inkling2.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/models/inkling2.cpp b/src/models/inkling2.cpp
index 618b60b4d..36b5b3b3a 100644
--- a/src/models/inkling2.cpp
+++ b/src/models/inkling2.cpp
@@ -366,7 +366,7 @@ ggml_tensor * llama_model_inkling2::graph::build_layer(int il, int ip, ggml_tens
         // with flash attention the mask goes in as F16 anyway: write the permuted bias straight to F16
         // (the F32 copy of an n_kv x n_tokens x n_head tensor is most of the compute buffer at long context)
         kq_b = ggml_permute(ctx0, kq_b, 2, 0, 1, 3);
-        kq_b = cparams.flash_attn ? ggml_cpy(ctx0, kq_b, ggml_new_tensor(ctx0, GGML_TYPE_F16, 4, kq_b->ne)) : ggml_cont(ctx0, kq_b);
+        kq_b = cparams.flash_attn ? ggml_cast(ctx0, kq_b, GGML_TYPE_F16) : ggml_cont(ctx0, kq_b);
         cb(kq_b, "kq_b", il);
 
         sinks = ggml_fill(ctx0, ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, n_head), 0.0f);
