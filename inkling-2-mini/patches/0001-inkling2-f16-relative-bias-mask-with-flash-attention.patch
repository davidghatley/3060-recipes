From aa0841ce32f7fe96565e4e44ea402f802f51f7d2 Mon Sep 17 00:00:00 2001
From: local <local@localhost>
Date: Fri, 20 Nov 2026 17:18:53 -0700
Subject: [PATCH 1/3] inkling2: f16 relative-bias mask with flash attention
 (smaller compute buffer)

---
 src/llama-graph.cpp     | 17 +++++++++++------
 src/models/inkling2.cpp |  5 ++++-
 2 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 1bd3f8d0f..ecfe3688c 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -4409,12 +4409,17 @@ ggml_tensor * llm_graph_context::build_attn(
 
     // a mask per head, in the dense layout of the input mask, which flash attention takes in F16
     ggml_tensor * kq_mask = attn_mask.raw;
-    if (kq_mask->type != GGML_TYPE_F32) {
-        kq_mask = ggml_cast(ctx0, kq_mask, GGML_TYPE_F32);
-    }
-    kq_mask = ggml_add(ctx0, kq_b, kq_mask);
-    if (cparams.flash_attn) {
-        kq_mask = ggml_cast(ctx0, kq_mask, GGML_TYPE_F16);
+    if (kq_b->type == GGML_TYPE_F16 && kq_mask->type == GGML_TYPE_F16) {
+        // F16 bias + F16 mask straight into the F16 flash-attention mask (no F32 intermediates)
+        kq_mask = ggml_add(ctx0, kq_b, kq_mask);
+    } else {
+        if (kq_mask->type != GGML_TYPE_F32) {
+            kq_mask = ggml_cast(ctx0, kq_mask, GGML_TYPE_F32);
+        }
+        kq_mask = ggml_add(ctx0, kq_b, kq_mask);
+        if (cparams.flash_attn) {
+            kq_mask = ggml_cast(ctx0, kq_mask, GGML_TYPE_F16);
+        }
     }
     cb(kq_mask, "kq_mask_rel_pos", il);
 
diff --git a/src/models/inkling2.cpp b/src/models/inkling2.cpp
index 45477a69e..618b60b4d 100644
--- a/src/models/inkling2.cpp
+++ b/src/models/inkling2.cpp
@@ -363,7 +363,10 @@ ggml_tensor * llama_model_inkling2::graph::build_layer(int il, int ip, ggml_tens
 
         ggml_tensor * kq_b = ggml_get_rows(ctx0, table, rel_pos);
         kq_b = ggml_reshape_4d(ctx0, kq_b, n_head, n_kv, n_tokens/n_stream, n_stream);
-        kq_b = ggml_cont(ctx0, ggml_permute(ctx0, kq_b, 2, 0, 1, 3));
+        // with flash attention the mask goes in as F16 anyway: write the permuted bias straight to F16
+        // (the F32 copy of an n_kv x n_tokens x n_head tensor is most of the compute buffer at long context)
+        kq_b = ggml_permute(ctx0, kq_b, 2, 0, 1, 3);
+        kq_b = cparams.flash_attn ? ggml_cpy(ctx0, kq_b, ggml_new_tensor(ctx0, GGML_TYPE_F16, 4, kq_b->ne)) : ggml_cont(ctx0, kq_b);
         cb(kq_b, "kq_b", il);
 
         sinks = ggml_fill(ctx0, ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, n_head), 0.0f);
