{
  "id": "kintsugi-27b",
  "title": "Kintsugi-27B at 2.47 bpw with a 262k window",
  "summary": "Qwen3.8-27B as EXL3 trellis codes in one 10.5 GB GGUF, on the author's llama.cpp fork. With the DFlash2 drafter it decodes at 39 tok/s on chat and 60 on code, against 16 without.",
  "status": "measured",
  "updated": "2026-11-22",
  "use_cases": [
    "coding",
    "agents",
    "long-context",
    "dense-model"
  ],
  "model": {
    "name": "Kintsugi-27B",
    "hf_repo": "CaryPalmer/Kintsugi-27B",
    "params": "27B",
    "architecture": "dense (Qwen3.8-27B)",
    "license": "Apache-2.0"
  },
  "weights": {
    "format": "GGUF (EXL3 trellis)",
    "quant": "EXL3 trellis 2.47 bpw",
    "bpw": 2.47,
    "size_gb": 10.5,
    "source": "https://huggingface.co/CaryPalmer/Kintsugi-27B",
    "file": "Kintsugi-27B-12G.gguf",
    "notes": "Drafter: dflash-Qwen3.8-27B-Q4_0.gguf (1.1 GB) from the same repo. Stock llama.cpp cannot load the model file."
  },
  "engine": {
    "name": "Kintsugi llama.cpp fork",
    "repo": "https://github.com/professorpalmer/Kintsugi-27B",
    "version": "Linux bundle v1.1.1",
    "cuda": "12.8 runtime"
  },
  "hardware": {
    "gpu": "NVIDIA GeForce RTX 3060",
    "vram_gb": 12,
    "ram_gb": 62,
    "cpu": "Intel Core i5-12500",
    "disk": "NVMe SSD",
    "os": "Linux",
    "driver": "615.78.08",
    "notes": "The desktop is on the same card (about 1 GB), so the launcher keeps a 600 MiB margin."
  },
  "serve": {
    "command": "./serve.sh",
    "script": "serve.sh",
    "port": 8080,
    "api": "OpenAI chat and responses at /v1, Anthropic at /v1/messages",
    "key_flags": [
      "launcher defaults: q4_0 K/V, 262,144 window, thinking medium",
      "KINTSUGI_DRAFT=off to disable the drafter",
      "KINTSUGI_CTX, KINTSUGI_KV, KINTSUGI_THINK pass through"
    ]
  },
  "context_tokens": 262144,
  "placement": "Weights (10.5 GB) and drafter in VRAM. Tiered K/V cache: 7,168 cells in VRAM with the drafter on (61,952 without), the rest of the window in RAM.",
